# Normalize text in the repo, but never hand CRLF to the Termux/Linux server:
# a CR in the shebang makes bash report "bad interpreter".
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.apk binary
*.zip binary
*.jar binary
*.keystore binary
*.jks binary
